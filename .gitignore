# corpus/ — Phase 0 CA-lookup engine spine
# The repo .gitignore is an allowlist ("*" then "!"-exceptions), so corpus/
# must be explicitly un-ignored. We allow the source + built artifact, but
# never the model cache or installed deps.
!corpus
!corpus/schema.md
!corpus/build.mjs
!corpus/retrieve.mjs
!corpus/embed.mjs
!corpus/ca-corpus.v0.json
!corpus/ca-corpus.v1.json
!corpus/PHASE0-RESULTS.md
!corpus/CORPUS-V1.md
!corpus/package.json
# never commit deps or the downloaded model weights
corpus/node_modules/
corpus/.cache/
corpus/.transformers-cache/
corpus/package-lock.json
corpus/**/.DS_Store

# smoke/ — first-run smoke test (pre-deploy regression guard for create/open flows)
!smoke
!smoke/first-run-smoke.js

# agent/ — the agent surface (doctrine 6: two doors, one core)
!agent
!agent/AGENT.md
!agent/manifest.json
!agent/harness
!agent/harness/package.json
!agent/harness/drive.mjs
!agent/harness/checks.mjs
!agent/harness/prove-red.mjs
!agent/harness/lint-agent-face.mjs
!agent/harness/test-lint-agent-face.mjs
agent/harness/node_modules/
agent/harness/package-lock.json
