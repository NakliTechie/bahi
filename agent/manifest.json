{
  "api": "bahi.agent",
  "version": "1.0.0",
  "app": {
    "name": "Bahi",
    "khataFormatVersion": "1.0",
    "schemaVersion": 12
  },
  "units": {
    "money": "integer paise; 100 paise = ₹1. Never a float, never a formatted string.",
    "date": "ISO-8601 calendar date, YYYY-MM-DD. No timestamps, no locales."
  },
  "limits": {
    "maxPaisePerLine": 2147483647,
    "maxPaiseNote": "Engine paths coerce with `| 0`, which truncates above 2^31-1. Amounts beyond this are refused at the boundary rather than silently wrapped.",
    "maxJournalLines": 500
  },
  "conventions": {
    "returns": "Every call resolves {ok:true,data} or {ok:false,error:{code,message}}. It never throws and never rejects.",
    "attribution": "Mutating calls are recorded in the append-only audit log with actor 'agent' or 'agent:<agentName>'. agentName is restricted to [A-Za-z0-9._-] so the 'agent:<name>' grammar stays unambiguous — a colon in the name would let an agent shape an actor string a reader could mistake for another principal ('owner', 'ca', 'ai', 'system').",
    "mutatingFlag": "Commands with mutating:true change the books. Everything else is a pure read.",
    "ranges": "A command with a `range` pair rejects a start later than its end with E_BAD_ARGS. A backwards range is a caller mistake, not an empty period — a reversed GST period must never return as a nil filing.",
    "nullIsAbsent": "For an OPTIONAL parameter, null and undefined both mean \"not supplied\" and the declared default applies. A required parameter is never satisfied by null."
  },
  "errors": [
    {
      "code": "E_UNKNOWN_COMMAND",
      "meaning": "No such command. Call agent.commands for the list."
    },
    {
      "code": "E_BAD_ARGS",
      "meaning": "Arguments failed the command's declared parameter spec."
    },
    {
      "code": "E_NO_FILE",
      "meaning": "No .khata file is open. Open one before calling file-scoped commands."
    },
    {
      "code": "E_READONLY",
      "meaning": "File is open read-only (newer .khata format than this build) — mutations refused."
    },
    {
      "code": "E_ENGINE",
      "meaning": "The accounting engine refused the operation (its message is passed through)."
    },
    {
      "code": "E_INTERNAL",
      "meaning": "Unexpected failure inside the dispatcher. This is a bug — report it."
    }
  ],
  "commands": [
