      "name": "agent.manifest",
      "summary": "The full machine-readable command manifest.",
      "mutating": false,
      "scope": "app",
      "route": null,
      "params": []
    },
    {
      "name": "agent.commands",
      "summary": "Command names only, for cheap discovery.",
      "mutating": false,
      "scope": "app",
      "route": null,
      "params": []
